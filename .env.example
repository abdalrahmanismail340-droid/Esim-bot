# ═══════════════════════════════════════════════════════════
#  إجباري — البوت مش هيشتغل من غيرهم
# ═══════════════════════════════════════════════════════════

# توكن البوت من @BotFather
BOT_TOKEN=123456789:AAExample-Your-Telegram-Bot-Token

# المالكين: عندهم كل الصلاحيات ومينفعش حد يشيلهم من جوه البوت.
# أكتر من واحد؟ افصل بينهم بفاصلة. تجيب الـ ID من @userinfobot
ADMIN_IDS=111111111,222222222


# ═══════════════════════════════════════════════════════════
#  التخزين — مهم جدًا، من غيره البيانات بتضيع مع كل إعادة تشغيل
# ═══════════════════════════════════════════════════════════

# قاعدة بيانات Turso (سحابية ومجانية) — الأفضل لـ Wispbyte / Railway
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# بديل: لو شغال محليًا أو عندك Volume حقيقي، سيب الاتنين اللي فوق فاضيين
# وحدد الفولدر اللي هيتحفظ فيه ملف esim_bot.db
# DB_DIR=/data


# ═══════════════════════════════════════════════════════════
#  بيانات المتجر
# ═══════════════════════════════════════════════════════════

# الـ Pay ID بتاع Binance اللي العملاء هيحولوا عليه
BINANCE_PAY_ID=123456789

# حساب الدعم الفني اللي بيظهر للعميل
SUPPORT_CONTACT=@your_support_username


# ═══════════════════════════════════════════════════════════
#  إعدادات التشغيل — كلها اختيارية، القيمة الافتراضية مكتوبة جنب كل واحدة
# ═══════════════════════════════════════════════════════════

# التوقيت المستخدم في كل التواريخ وفترات التقارير (افتراضي: Africa/Cairo)
TIMEZONE=Africa/Cairo

# رمز العملة اللي بيظهر جنب الأسعار (افتراضي: $)
CURRENCY=$

# ينبهك لما باقة يتبقى ليها العدد ده أو أقل (افتراضي: 3)
LOW_STOCK_THRESHOLD=3

# الضمان الافتراضي بالأيام لما تضغط «تخطي» وانت بتضيف ستوك (افتراضي: 7)
DEFAULT_WARRANTY_DAYS=7

# أقصى عدد شرايح في الطلب الواحد — حماية من الطلبات الغلط (افتراضي: 50)
MAX_BULK_QTY=50

# فوق العدد ده في الطلب الواحد، الأكواد بتتبعت في ملف بدل QR لكل شريحة (افتراضي: 5)
QR_LIMIT=5


# ═══════════════════════════════════════════════════════════
#  اختياري — تحقق تلقائي من الدفع
# ═══════════════════════════════════════════════════════════

# مفاتيح Binance API. لو سيبتهم فاضيين، طلبات الشحن هتوصلك يدوي
# وتشحن للعميل بنفسك من اللوحة ← 💰 شحن / خصم رصيد
BINANCE_API_KEY=
BINANCE_API_SECRET=

# قراءة سكرين شوت التحويل تلقائيًا.
# مفتاح مجاني من https://ocr.space/ocrapi/freekey
# لو فاضي، العميل هيبعت رقم المعاملة كتابة بس
OCRSPACE_API_KEY=
